# ── Copy to .env (or export these) and adjust ────────────────────────────────

# Backend
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5vl:7b
TEXT_MODEL=qwen3:4b
OCR_BACKEND=auto
LANGUAGE_BACKEND=auto
DEFAULT_LANGUAGE=en

# Database. Default is SQLite under data/.
# DATABASE_URL=sqlite:///data/assistant.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/assistant
SQL_ECHO=0

# Where runtime data lives (chats, vector index, uploads, documents)
# DATA_DIR=./data
# DOCUMENTS_DIR=./data/documents
# CHROMA_DIR=./data/chroma_store

# Frontend -> API
API_BASE_URL=http://127.0.0.1:8000/api
API_CHAT_TIMEOUT=300
